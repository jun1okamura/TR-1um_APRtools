  cell (REG8x16) {
    area : 372826.8;
    dont_use : true;   /* 座標指定で置くマクロ。合成が挿してはいけない */
    dont_touch : true;
    is_macro_cell : true;
    /* 測定: REG8x16.spi / 書込み後に ADD を振って読出し */
    /* ADD のビット間は 72.9-73.2 fF。大きい方を採った */
    bus (ADD) {
      bus_type : bus4;
      direction : input;
      capacitance : 73.155;
      max_transition : 16;
      /* アドレスの保持。WEB 立上りのあとこれだけ動かせない。5.5ns では壊れ 6ns で保つ。配線容量なし。 ★ **設計側が WEB をクロックとして宣言したときだけ** OpenSTA が見る （create_clock が無いと「パス無し」になる。3.1.0 で確認） */
      timing () {
        related_pin : "WEB";
        timing_type : hold_rising;
        rise_constraint (scalar) { values("6.0000"); }
        fall_constraint (scalar) { values("6.0000"); }
      }
    }
    pin (WEB) {
      direction : input;
      capacitance : 82.797;
      max_transition : 16;
      /* 書込みに要る低パルスの最小幅。10.5ns では書けず 11ns で書ける（刻み 0.5ns）。配線容量なし。
         ★ **OpenSTA はこれを見ない**（3.1.0 で確認。`clock : true` を足しても、低 5ns のクロックを当てても違反が出ない。`set_min_pulse_width` をピンに当てても無反応、クロックに当てると別のピンを検査する）。**記録として置いてあるだけ**で、担保は ngspice の回帰側。 */
      timing () {
        related_pin : "WEB";
        timing_type : min_pulse_width;
        fall_constraint (scalar) {
          values("11.0000");
        }
      }
    }
    bus (D) {
      bus_type : bus8;
      direction : input;
      capacitance : 82.750;
      max_transition : 16;
      /* データの保持。WEB 立上りのあとこれだけ動かせない。5.5ns では壊れ 6ns で保つ。配線容量なし。 ★ **設計側が WEB をクロックとして宣言したときだけ** OpenSTA が見る （create_clock が無いと「パス無し」になる。3.1.0 で確認） */
      timing () {
        related_pin : "WEB";
        timing_type : hold_rising;
        rise_constraint (scalar) { values("6.0000"); }
        fall_constraint (scalar) { values("6.0000"); }
      }
    }
