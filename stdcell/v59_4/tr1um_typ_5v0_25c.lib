/* TR-1um (IP62) 標準セルライブラリ — Liberty
 *
 * <APRtools>/char/mklib.py が char/*.json から自動生成。手で編集しないこと。
 * 元データは KLayout が DRC/LVS クリーンなレイアウトから抽出した
 * ネットリスト (lef/extracted/*.extracted) を ngspice (BSIM3 level49) で
 * 特性化したもの。拡散の実面積・周長 (AS/AD/PS/PD) を含む。
 * 回路の正しさは真理値表 140 点 / 順序 79 点 / TAP・FILL 全数で確認済み。
 *
 * 遅延が負の升目が 2 つある (NAND3 C->Y / NAND4 D->Y の 16ns 入力・10fF)。
 * 鈍い入力を軽い負荷で受けると、入力が 50% を通る前に出力が 50% を通る。
 * 測定どおりの物理的な値なので、丸めていない。
 *
 * コーナー: typical / 5.0V / 25degC （PDK に ss/ff のモデルが無いので 1 本のみ）
 * 遅延の測定点: 入力 50% -> 出力 50%
 * 遷移の測定点: 20% -> 80%
 * 単位: 時間 ns / 容量 fF / 面積 um^2
 *
 * OSS_ESD_5V_DIO の 3 ステートアークの測定条件:
 *   enable  遅延 HIZ 50% -> PAD 50%。PAD は 1Mohm で逆レールに置いてから。
 *           遷移は PAD の 20-80%（逆レールから駆動レールへのフルスイング）。
 *   disable 遅延 HIZ 50% -> 駆動電流が 100uA を切るまで。PAD を VDD/2 の
 *           電圧源で押さえて電流で判定するので負荷に依らない。
 *           **遷移は電圧では定義できない**（放しても波形が動かない）ので、
 *           駆動電流が初期値の 80% -> 20% に落ちる時間を入れてある。
 *
 * 入っていないセル: ADDBUF / REGBUF / TLAT / DEC0 / DEC2 / DEC16 など
 *   アレイ内部で abut して使う CLASS BLOCK のセル。P&R の行に流さないので
 *   タイミングを持たせる意味がない（機能は ngspice で確認済み）。
 */

library (tr1um_typ_5v0_25c) {
  technology (cmos);
  delay_model : table_lookup;
  bus_naming_style : "%s[%d]";
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1, ff);

  nom_process : 1.0;
  nom_temperature : 25;
  nom_voltage : 5.0;
  default_max_transition : 16;
  default_max_fanout : 16;

  slew_lower_threshold_pct_rise : 20;
  slew_upper_threshold_pct_rise : 80;
  input_threshold_pct_rise : 50;
  output_threshold_pct_rise : 50;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_fall : 80;
  input_threshold_pct_fall : 50;
  output_threshold_pct_fall : 50;
  slew_derate_from_library : 1.0;

  operating_conditions (typ) {
    process : 1.0;
    temperature : 25;
    voltage : 5.0;
    tree_type : balanced_tree;
  }
  default_operating_conditions : typ;

  lu_table_template (delay_template_7x7) {
